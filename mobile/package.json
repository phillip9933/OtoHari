{
  "name": "droppedneedle-mobile",
  "version": "0.23.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "sync": "pnpm build && cap sync",
    "android:prepare-update": "node scripts/prepare-android-update.mjs",
    "test:journey": "playwright test --config tests/playwright.config.ts",
    "lint": "eslint src tests vite.config.ts",
    "format:check": "prettier --config ../frontend/.prettierrc --check src tests vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@lucide/svelte": "^1.76.0",
    "@noble/hashes": "2.4.0",
    "postcss": "8.5.33",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.5"
  }
}
